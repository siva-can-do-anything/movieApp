{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Movie Tickets Web API - ASP.NET Core on AWS Lambda behind API Gateway (HTTP API).",
  "Parameters": {
    "EnableSwagger": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [ "true", "false" ],
      "Description": "Expose /swagger in the deployed API."
    }
  },
  "Resources": {
    "MovieTicketsApiFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "MovieTickets.Api",
        "Runtime": "dotnet8",
        "CodeUri": "",
        "MemorySize": 512,
        "Timeout": 30,
        "Architectures": [ "x86_64" ],
        "Policies": [ "AWSLambdaBasicExecutionRole" ],
        "Environment": {
          "Variables": {
            "TicketStorage__FilePath": "/tmp/tickets.json",
            "TicketStorage__SeedFilePath": "Data/tickets.json",
            "EnableSwagger": { "Ref": "EnableSwagger" }
          }
        },
        "Events": {
          "ProxyResource": {
            "Type": "HttpApi",
            "Properties": { "Path": "/{proxy+}", "Method": "ANY" }
          },
          "RootResource": {
            "Type": "HttpApi",
            "Properties": { "Path": "/", "Method": "ANY" }
          }
        }
      }
    }
  },
  "Outputs": {
    "ApiURL": {
      "Description": "Base URL of the deployed API",
      "Value": { "Fn::Sub": "https://${ServerlessHttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/" }
    }
  }
}
